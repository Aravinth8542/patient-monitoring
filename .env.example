POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=patient_monitoring
DATABASE_URL=postgresql+psycopg://your_database_user:your_database_password@127.0.0.1:5433/patient_monitoring
# Set to 1 only for deterministic replay/testing; never in production
TEST_MODE=0

# Separate restricted PostgreSQL role for HTTP ingestion (not migration owner)
RUNTIME_DATABASE_URL=postgresql+psycopg://patient_monitoring_runtime:your_runtime_password@127.0.0.1:5433/patient_monitoring
